# Serveur
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Base de données PostgreSQL (Prisma)
# Doit correspondre au service « db » de docker-compose.yml.
DATABASE_URL="postgresql://netandpro:netandpro_dev@localhost:5434/netandpro?schema=public"

# Comptes créés par le seed (npm run seed).
# must_change_password est imposé : le mot de passe devra être changé
# à la première connexion. À personnaliser avant toute mise en production.
SEED_ADMIN_EMAIL=admin@netandpro.cm
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrateur NetandPro
SEED_SUPERVISOR_EMAIL=superviseur@netandpro.cm
SEED_SUPERVISOR_PASSWORD=
SEED_SUPERVISOR_NAME=Superviseur NetandPro

# Sauvegardes. Par défaut pg_dump est exécuté dans le conteneur, ce qui
# garantit une version identique à celle du serveur. Renseigner
# PG_DUMP_PATH pour utiliser un binaire installé sur la machine.
PG_CONTAINER=netandpro_postgres
# PG_DUMP_PATH=

# Ancienne base MySQL — conservée uniquement pour scripts/migrate-mysql-to-postgres.js.
# Aucun code applicatif ne s'y connecte plus.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=
DB_PASSWORD=
DB_NAME=netandpro
DB_SSL=false

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Email
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_RECEIVE=

# Documentation API
ENABLE_API_DOCS=true
API_DOCS_PATH=/api/docs
API_DOCS_USER=
API_DOCS_PASSWORD=